{% if standalone %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{% endif %}<title>Q Agent Eval Findings</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,650&family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Generated by `qeval findings`. Layout: one reading column, one card per finding, rates drawn to scale. */
:root {
  --bg: #f7f8f7; --surface: #ffffff; --ink: #18201f; --muted: #5b6764; --line: #dde3e1;
  --accent: #0d6e6a; --accent-soft: #e2f0ee;
  --crit: #b3261e; --crit-soft: #fbe8e6; --major: #9a5b00; --major-soft: #fbefdc;
  --minor: #4a5b75; --minor-soft: #e8edf4; --pass: #2e7d4f; --pass-soft: #e3f2e8;
  --f-display: "Source Serif 4", Georgia, serif;
  --f-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #111615; --surface: #182020; --ink: #e6ecea; --muted: #9aa8a4; --line: #2b3634;
    --accent: #5cc4bc; --accent-soft: #163330; --crit: #ff8a80; --crit-soft: #3a1a18;
    --major: #f2b45a; --major-soft: #3a2a12; --minor: #a9bbd6; --minor-soft: #1f2734;
    --pass: #7fd3a0; --pass-soft: #183025; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #111615; --surface: #182020; --ink: #e6ecea; --muted: #9aa8a4; --line: #2b3634;
  --accent: #5cc4bc; --accent-soft: #163330; --crit: #ff8a80; --crit-soft: #3a1a18;
  --major: #f2b45a; --major-soft: #3a2a12; --minor: #a9bbd6; --minor-soft: #1f2734;
  --pass: #7fd3a0; --pass-soft: #183025; color-scheme: dark;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.55 var(--f-body); }
.wrap { max-width: 980px; margin: 0 auto; padding-inline: 20px; padding-block: 36px 64px; display: flex; flex-direction: column; gap: 28px; }
h1, h2 { font-family: var(--f-display); font-weight: 650; margin: 0; text-wrap: balance; }
h1 { font-size: clamp(26px, 4vw, 36px); line-height: 1.15; }
h2 { font-size: 20px; line-height: 1.3; flex: 1 1 280px; }
p { margin: 0; max-width: 70ch; }
.muted { color: var(--muted); }
.meta { font: 12.5px/1.6 var(--f-mono); color: var(--muted); display: flex; flex-direction: column; gap: 2px; }
.pill { display: inline-block; font: 500 11.5px var(--f-mono); padding: 1px 8px; border-radius: 999px; white-space: nowrap; }
.critical { color: var(--crit); background: var(--crit-soft); }
.major { color: var(--major); background: var(--major-soft); }
.minor { color: var(--minor); background: var(--minor-soft); }
.st { color: var(--accent); background: var(--accent-soft); }
.card { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--line); border-radius: 10px; padding: 16px 18px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.card.critical { border-left-color: var(--crit); background: var(--surface); color: var(--ink); }
.card.major { border-left-color: var(--major); background: var(--surface); color: var(--ink); }
.head { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: baseline; }
.headline { font: 500 15px var(--f-mono); font-variant-numeric: tabular-nums; }
.rules { display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
.rules b { font-family: var(--f-mono); font-weight: 500; }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
th { font-size: 11.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 600; }
td.num { font-family: var(--f-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
tr.twin td:first-child { color: var(--muted); }
.bar { position: relative; height: 8px; min-width: 90px; background: var(--line); border-radius: 4px; }
.bar .ci { position: absolute; top: 0; bottom: 0; background: currentColor; opacity: .3; border-radius: 4px; }
.bar .pt { position: absolute; top: -3px; width: 4px; height: 14px; margin-left: -2px; background: currentColor; border-radius: 2px; }
.ex { background: var(--accent-soft); border-radius: 8px; padding: 10px 12px; display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
.ex .lbl { font: 500 11.5px var(--f-mono); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
.cause { font-size: 14px; }
.card.advisory { border-left-style: dashed; }
.an { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; font-size: 14px; }
.an p { max-width: none; }
.an .lbl, .ex .lbl { font: 500 11.5px var(--f-mono); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
.warn { color: var(--crit); }
.kv { display: grid; grid-template-columns: 8.5em 1fr; gap: 3px 12px; margin: 0; }
.kv dt { color: var(--muted); }
.kv dd { margin: 0; min-width: 0; }
details.evid { display: flex; flex-direction: column; gap: 8px; }
details.evid > summary { margin-bottom: 8px; }
details.evid .ex + .ex { margin-top: 8px; }
.ex.twin { background: var(--bg); border: 1px dashed var(--line); }
.small { font-size: 13px; }
@media (max-width: 520px) { .kv { grid-template-columns: 1fr; } }
details summary { cursor: pointer; color: var(--muted); font-size: 13px; }
code { font-family: var(--f-mono); font-size: .9em; }
</style>
{% if standalone %}</head>
<body>
{% endif %}<div class="wrap">
<header style="display:flex;flex-direction:column;gap:10px">
  <h1>Q agent vs its Behaviour Spec: {{ d.findings|length }} findings</h1>
  <p class="muted">Generated by <code>qeval findings</code> from stored gradings ({{ d.generated_at }}). Rates are failing runs out of independent runs on fresh accounts; bars show the rate and its 95% Wilson interval. A twin is a near-identical scenario that must not fail.</p>
  <div class="meta">
    {% for r in d.runs %}<span>{{ r.name }} · k={{ r.k }} · {{ r.scored_runs }} scored runs · grading {{ r.grading_id }} · harness {{ r.harness_sha }}</span>{% endfor %}
    {% set v = d.runs[0].agent_version %}<span>agent {{ v.model }} · prompt {{ v.prompt_sha }} · commit {{ v.commit }}</span>
  </div>
</header>

{% macro cell(c, sev) %}
  {% if c %}<td class="num">{{ c.fails }}/{{ c.n }}</td>
  <td style="color: var(--{{ 'crit' if sev == 'critical' else ('muted' if sev == 'twin' else 'major') }})"><div class="bar" title="{{ c.ci[0]|pct }}–{{ c.ci[1]|pct }}"><span class="ci" style="left:{{ (c.ci[0]*100)|round(1) }}%;width:{{ ((c.ci[1]-c.ci[0])*100)|round(1) }}%"></span><span class="pt" style="left:{{ (c.fails/c.n*100)|round(1) }}%"></span></div></td>
  {% else %}<td class="num">–</td><td></td>{% endif %}
{% endmacro %}

{% for f in d.findings %}
{% if f.advisory and (loop.first or not loop.previtem.advisory) %}
<section style="display:flex;flex-direction:column;gap:6px">
  <h2 style="flex:none">Advisory findings (not counted)</h2>
  <p class="muted">These rest only on LLM-judge checks that have not yet passed blind human calibration. Their numbers are shown for review but are not part of any score, finding frequency or CI gate.</p>
</section>
{% endif %}
<article class="card {{ f.severity }}{% if f.advisory %} advisory{% endif %}" id="{{ f.id }}">
  <div class="head">
    <h2>{{ loop.index }}. {{ f.title }}</h2>
    <span class="pill {{ f.severity }}">{{ f.severity }}</span>
    <span class="pill st">{{ f.status_label }}</span>
    {% if f.advisory %}<span class="pill minor">advisory · not counted</span>{% endif %}
  </div>
  {% if f.headline %}<div class="headline">{{ f.headline.fails }}/{{ f.headline.n }} runs failed in {{ f.headline.run }} [{{ f.headline.ci[0]|pct }}–{{ f.headline.ci[1]|pct }}]</div>{% endif %}
  <div class="rules">
    {% for r in f.rules %}<div><b>{{ r.id }}</b> {{ r.title }}. <span class="muted">Expected: {{ r.expected }}.</span></div>{% endfor %}
  </div>
  <div class="scroll"><table>
    <thead><tr><th>Scenario</th>{% for r in d.runs %}<th>{{ r.name }}</th><th></th>{% endfor %}</tr></thead>
    <tbody>
    {% for s in f.scenarios %}<tr><td>{{ s.title }}</td>{% for c in s.runs %}{{ cell(c, f.severity) }}{% endfor %}</tr>{% endfor %}
    {% for s in f.twins %}<tr class="twin"><td>Twin: {{ s.title }}</td>{% for c in s.runs %}{{ cell(c, 'twin') }}{% endfor %}</tr>{% endfor %}
    </tbody>
  </table></div>
  {% if f.breakdown %}
  <div class="scroll"><table>
    <thead><tr><th>{{ f.breakdown.by }}</th><th>{{ f.breakdown.count }}</th><th>{{ f.breakdown.kind or 'replies' }}</th></tr></thead>
    <tbody>{% for b in f.breakdown.rows %}<tr><td><code>{{ b.group }}</code></td><td>{% for k, v in b.counts.items() %}<code>{{ k }}</code> × {{ v }}{% if not loop.last %}, {% endif %}{% endfor %}</td><td class="num">{{ b.total }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% endif %}
  {% if f.cause %}<p class="cause"><b>Likely cause (hypothesis):</b> {{ f.cause }}</p>{% endif %}
  {% if f.examples %}
  <details class="evid"><summary>Evidence: {{ f.examples|length }} failing example{{ 's' if f.examples|length != 1 }}{% if f.twin_examples %}, {{ f.twin_examples|length }} passing twin{{ 's' if f.twin_examples|length != 1 }}{% endif %}</summary>
    {% for e in f.examples %}
    <div class="ex">
      <span class="lbl">{{ e.id }} · {{ e.scenario_title }} · {{ e.run }} rep {{ e.rep }}{% if e.turn_idx is not none %} · turn {{ e.turn_idx }}{% endif %}</span>
      <div><b>User:</b> “{{ e.user }}”</div>
      <div><b>Q ({{ e.reply_kind }}{% if e.urgency %}, {{ e.urgency }}{% endif %}):</b> “{{ e.reply[:500] }}{% if e.reply|length > 500 %}…{% endif %}”</div>
      <div><b>{{ e.check }}:</b> {{ e.got }}</div>
    </div>
    {% endfor %}
    {% for e in f.twin_examples %}
    <div class="ex twin">
      <span class="lbl">{{ e.id }} · passing twin · {{ e.scenario_title }}</span>
      <div><b>User:</b> “{{ e.user }}”</div>
      <div><b>Q ({{ e.reply_kind }}{% if e.urgency %}, {{ e.urgency }}{% endif %}):</b> “{{ e.reply[:300] }}{% if e.reply|length > 300 %}…{% endif %}”</div>
    </div>
    {% endfor %}
  </details>
  {% endif %}
</article>
{% endfor %}

{% if d.notes %}
<section><h2 style="margin-bottom:8px">Notes</h2><ul>{% for n in d.notes %}<li>{{ n }}</li>{% endfor %}</ul></section>
{% endif %}
</div>
{% if standalone %}</body>
</html>{% endif %}
